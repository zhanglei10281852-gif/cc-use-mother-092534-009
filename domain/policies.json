  "policies": [
    {
      "code": "P-09-01",
      "name": "版本绑定",
      "description": "证据更正只能追加新记录并引用被更正项，哈希链不可断"
    },
    {
      "code": "P-09-02",
      "name": "暴露阶段区分",
      "description": "实际领取与仅生成清单必须区分暴露阶段 listed/packaged/received"
    },
    {
      "code": "P-09-03",
      "name": "通知矩阵",
      "description": "通知义务与截止按租户地区、数据类别与实际暴露阶段确定"
    },
    {
      "code": "P-09-04",
      "name": "双签披露",
      "description": "对外披露必须完成法务和安全双签，且隐藏其他租户信息"
    },
    {
      "code": "P-09-05",
      "name": "范围冲突复核",
      "description": "并发调查员对同一租户范围判断冲突时必须进入复核裁决"
    },
    {
      "code": "P-09-06",
      "name": "恢复续跑",
      "description": "监管截止时间锚定绝对时刻，服务恢复后重放继续推进，不重置时钟"
    }
  ],
