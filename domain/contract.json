{
  "project": "智能体泄露事件证据保全",
  "entities": [
    "security_incident",
    "evidence_item",
    "custody_entry",
    "exposure_finding",
    "scope_review",
    "affected_party",
    "notification_duty",
    "notification_receipt",
    "containment_action",
    "disclosure",
    "credential_version"
  ],
  "states": [
    "triage",
    "preserving",
    "scoping",
    "reviewing",
    "notifying",
    "contained",
    "closed",
    "reopened"
  ],
  "exposure_stages": [
    {"stage": "none", "depth": 0, "meaning": "仅有可疑请求，未证实文件离开运行空间"},
    {"stage": "listed", "depth": 1, "meaning": "文件或目录被列出（清单摘要）"},
    {"stage": "packaged", "depth": 2, "meaning": "文件被打包但未见领取"},
    {"stage": "delivered", "depth": 3, "meaning": "文件被实际领取（交付回执）"}
  ],
  "party_states": ["proposed", "confirmed", "excluded", "notifying", "notified"],
  "duty_states": ["pending", "sent", "superseded"],
  "disclosure_states": ["draft", "signed", "issued"],
  "event_types": [
    "incident.opened",
    "incident.closed",
    "incident.reopened",
    "evidence.preserved",
    "evidence.corrected",
    "finding.recorded",
    "finding.supplemented",
    "scope.judged",
    "scope.contested",
    "scope.consensus",
    "scope.resolved",
    "duty.generated",
    "duty.superseded",
    "notification.sent",
    "containment.applied",
    "disclosure.created",
    "disclosure.signed",
    "disclosure.issued"
  ],
  "time_policy": "ISO 8601 with timezone",
  "identifier_policy": "同一租户和对象类型内业务标识唯一；证据以 (事件, 指纹) 去重",
  "version_policy": "已发布规则与事实通过新版本追加，不覆盖历史；证据链为前序哈希链，可独立校验",
  "rules": [
    "证据更正只能追加新记录并引用被更正项，原记录与哈希链保留",
    "实际领取、打包与仅生成清单必须区分为不同暴露阶段，阶段不得深于证据支持",
    "重复导入同一证据（指纹相同）不新建记录、不扩大计数",
    "通知截止按租户地区、数据类别与实际暴露阶段确定，时钟自事件确认发现起算且不中断",
    "调查结论变化时重新评估义务：仅作废尚未发送的义务，已发送通知作为确认事实不撤回",
    "并发调查员对范围作出冲突判断时自动进入复核，由事件指挥官裁决",
    "对外披露必须完成法务和安全双签，发布文本隐去范围外租户信息",
    "全局隔离会中断所有租户，默认禁止定向以外的动作，须指挥官授权并记录理由",
    "服务恢复后从事件流重建投影，监管时钟、隔离动作与待通知队列继续推进",
    "管理接口须能解释每名受影响方被纳入或排除的理由、证据与时间线"
  ]
}
